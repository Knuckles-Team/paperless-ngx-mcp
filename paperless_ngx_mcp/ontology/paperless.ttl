@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Native Paperless-ngx structural model. Instances use keyed opaque identifiers.
# Content, names, filenames, paths, URLs, timestamps, and provider identifiers are
# deliberately absent from the durable projection.

:PaperlessDocumentReference a owl:Class ;
    rdfs:label "Opaque Paperless-ngx document reference" ;
    rdfs:comment "A content-free keyed reference to a provider document." .

:PaperlessCorrespondentReference a owl:Class ;
    rdfs:label "Opaque Paperless-ngx correspondent reference" ;
    rdfs:comment "A name-free keyed reference to a provider correspondent." .

:PaperlessTagReference a owl:Class ;
    rdfs:label "Opaque Paperless-ngx tag reference" ;
    rdfs:comment "A label-free keyed reference to a provider tag." .

:PaperlessDocumentTypeReference a owl:Class ;
    rdfs:label "Opaque Paperless-ngx document-type reference" ;
    rdfs:comment "A label-free keyed reference to a provider document type." .

:PaperlessStoragePathReference a owl:Class ;
    rdfs:label "Opaque Paperless-ngx storage-path reference" ;
    rdfs:comment "A path-free keyed reference to provider storage placement." .

:hasCorrespondentReference a owl:ObjectProperty ;
    rdfs:domain :PaperlessDocumentReference ;
    rdfs:range :PaperlessCorrespondentReference .

:hasTagReference a owl:ObjectProperty ;
    rdfs:domain :PaperlessDocumentReference ;
    rdfs:range :PaperlessTagReference .

:hasDocumentTypeReference a owl:ObjectProperty ;
    rdfs:domain :PaperlessDocumentReference ;
    rdfs:range :PaperlessDocumentTypeReference .

:hasStoragePathReference a owl:ObjectProperty ;
    rdfs:domain :PaperlessDocumentReference ;
    rdfs:range :PaperlessStoragePathReference .

<http://knuckles.team/kg/paperless> a owl:Ontology ;
    rdfs:label "Paperless-ngx zero-PII structural ontology" ;
    rdfs:comment "Keyed opaque document and classification relationships for governed Paperless-ngx ingestion." ;
    owl:imports <http://knuckles.team/kg> .
